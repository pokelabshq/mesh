# deploy.mesh — deploy a docker container
# usage: mesh run deploy.mesh --input-json '{"image": "nginx:latest", "name": "web", "port": 80}'

"starting deployment" → log level="info"

# pull latest image
"pulling image" → shell cmd="docker pull {{.image}}" → log

# stop and remove old container if exists
"stopping old container" → shell cmd="docker stop {{.name}} 2>/dev/null; docker rm {{.name}} 2>/dev/null; true" → log

# start new container
"starting new container" → shell cmd="docker run -d --name {{.name}} -p {{.port}}:80 {{.image}}" → log

# verify health
"verifying health" → shell cmd="docker inspect --format='{{.State.Running}}' {{.name}}" → trim → log

"deployment complete" → log level="info"
