# triage.mesh — triage GitHub issues into priority buckets
# fetches open issues, filters by labels, sorts by reaction count

http.get "https://api.github.com/repos/thealxlabs/council/issues?state=open&per_page=100" → json.parse → as "issues"

"found {{.issues | count}} open issues" → log level="info"

# filter bugs
issues → filter where="labels contains bug" → sort by="reactions.total_count" → take 5 → as "critical_bugs"
"{{.critical_bugs | count}} critical bugs" → log

# filter requests  
issues → filter where="labels contains enhancement" → sort by="reactions.total_count" → take 5 → as "top_requests"
"{{.top_requests | count}} top feature requests" → log

# output summary
"triage complete" → log level="info"
