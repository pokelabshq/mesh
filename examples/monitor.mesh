# monitor.mesh — monitor website endpoints
# usage: mesh run monitor.mesh --input-json '{"urls": ["https://pokelabs.org", "https://thealxlabs.ca"]}'

"monitoring {{.urls | count}} endpoints" → log level="info"

urls → as "results"

http.get "https://pokelabs.org" → as "r1"
"http://pokelabs.org status: {{.r1.status}}" → log

http.get "https://thealxlabs.ca" → as "r2"  
"http://thealxlabs.ca status: {{.r2.status}}" → log

"monitoring complete" → log level="info"
