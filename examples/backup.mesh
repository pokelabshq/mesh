# backup.mesh — backup a directory with compression and checksum
# usage: mesh run backup.mesh --input-json '{"dir": "/home/alx/projects", "dest": "/tmp/backup"}'

"starting backup of {{.dir}}" → log level="info"

now → format as "{{.}}" → replace old="_" new="-" → replace old=":" new="-" → replace old="T" new="_"

"compressing {{.dir}}" → log
shell cmd="mkdir -p {{.dest}} && tar czf {{.dest}}/backup_latest.tar.gz -C $(dirname {{.dir}}) $(basename {{.dir}})" → log

shell cmd="sha256sum {{.dest}}/backup_latest.tar.gz" → trim → log
"backup complete" → log level="info"
